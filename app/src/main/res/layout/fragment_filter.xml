<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    tools:context=".FilterFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_back_arrow"
                app:tint="#000000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Filter"
                android:textColor="#333333"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Reset"
                android:textColor="#FF5252"
                android:textSize="14sp" />
        </RelativeLayout>

        <!-- Transaction Type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/button_outline_rounded"
                android:gravity="center"
                android:text="Rentals"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/button_outline_rounded"
                android:gravity="center"
                android:text="Buy"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/button_outline_rounded"
                android:gravity="center"
                android:text="Sell"
                android:textColor="#000000"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Property Type -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Property Type"
            android:textColor="#333333"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_gray"
                android:gravity="center"
                android:text="Any"
                android:textColor="#000000"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_gray"
                android:gravity="center"
                android:text="House"
                android:textColor="#000000"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_gray"
                android:gravity="center"
                android:text="Hotel"
                android:textColor="#000000"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_gray"
                android:gravity="center"
                android:text="Apartment"
                android:textColor="#000000"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_gray"
                android:gravity="center"
                android:text="Costs"
                android:textColor="#000000"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_gray"
                android:gravity="center"
                android:text="Resort"
                android:textColor="#000000"/>
        </LinearLayout>

        <!-- Location -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"/>
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="See all"
                android:textColor="#FF5252"
                android:textSize="14sp"/>
        </RelativeLayout>

         <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_gray"
                android:gravity="center"
                android:text="Ikeja"
                android:textColor="#000000"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_gray"
                android:gravity="center"
                android:text="Mainland"
                android:textColor="#000000"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_gray"
                android:gravity="center"
                android:text="Island"
                android:textColor="#000000"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_gray"
                android:gravity="center"
                android:text="CMS"
                android:textColor="#000000"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_gray"
                android:gravity="center"
                android:text="Ago, Okota"
                android:textColor="#000000"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_gray"
                android:gravity="center"
                android:text="Ikoyi"
                android:textColor="#000000"/>
        </LinearLayout>
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check prices"
            android:textColor="#333333"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <!-- Area -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Area (sqft)"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dropdown"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Min"
                    android:textColor="#000000"
                    android:layout_centerVertical="true"/>
                
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/arrow_down_float"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:tint="#000000"/>
            </RelativeLayout>

            <View
                android:layout_width="24dp"
                android:layout_height="2dp"
                android:background="#000000"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>

             <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dropdown"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Max"
                    android:textColor="#000000"
                    android:layout_centerVertical="true"/>
                
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/arrow_down_float"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:tint="#000000"/>
            </RelativeLayout>
        </LinearLayout>

        <!-- Plot Area -->
         <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Plot Area (sqft)"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="32dp">

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dropdown"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Min"
                    android:textColor="#000000"
                    android:layout_centerVertical="true"/>
                
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/arrow_down_float"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:tint="#000000"/>
            </RelativeLayout>

            <View
                android:layout_width="24dp"
                android:layout_height="2dp"
                android:background="#000000"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>

             <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dropdown"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Max"
                    android:textColor="#000000"
                    android:layout_centerVertical="true"/>
                
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/arrow_down_float"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:tint="#000000"/>
            </RelativeLayout>
        </LinearLayout>

        <!-- Check Properties Button -->
        <Button
            android:id="@+id/btnCheckProperties"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Check Properties"
            android:backgroundTint="#3C3D37"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textAllCaps="false"/>

    </LinearLayout>

</ScrollView>
