<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".VerificationFragment">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:padding="24dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_back_arrow"
            android:contentDescription="Back button" />

        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/backButton"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Verify Code"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/titleText"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Please enter the code we sent to your email\ndon'vadunrey@gmail.com"
            android:textColor="#666666"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <!-- OTP Input Container -->
        <LinearLayout
            android:id="@+id/otpContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/subtitleText"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- OTP Box 1 -->
            <EditText
                android:id="@+id/otpBox1"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/otp_box_background"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/black"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- OTP Box 2 -->
            <EditText
                android:id="@+id/otpBox2"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/otp_box_background"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/black"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- OTP Box 3 -->
            <EditText
                android:id="@+id/otpBox3"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/otp_box_background"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/black"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- OTP Box 4 -->
            <EditText
                android:id="@+id/otpBox4"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/otp_box_background"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/black"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Didn't receive code text -->
        <TextView
            android:id="@+id/didntReceiveText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/otpContainer"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="24dp"
            android:text="Didn't receive OTP?"
            android:textColor="#999999"
            android:textSize="14sp" />

        <!-- Resend code link -->
        <TextView
            android:id="@+id/resendCodeLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/didntReceiveText"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="4dp"
            android:text="Resent code"
            android:textColor="#717C6D"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Verify Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/verifyButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_below="@id/resendCodeLink"
            android:layout_marginTop="32dp"
            android:backgroundTint="#717C6D"
            android:text="Verify"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textAllCaps="false"
            app:cornerRadius="28dp" />

    </RelativeLayout>

</FrameLayout>