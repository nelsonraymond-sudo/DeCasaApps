<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@color/white"
    tools:context=".ProfileActivity">

    <RelativeLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="1dp"
        android:padding="20dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="Complete Your Profile"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Profile Picture Container -->
        <RelativeLayout
            android:id="@+id/profilePictureContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/titleText"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="32dp">

            <!-- Profile Picture Circle -->
            <androidx.cardview.widget.CardView
                android:id="@+id/profileCard"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:cardCornerRadius="50dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#D9D9D9">

                <ImageView
                    android:id="@+id/profileImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="24dp"
                    android:src="@drawable/ic_person_large"
                    android:contentDescription="Profile picture"
                    app:tint="#666666" />
            </androidx.cardview.widget.CardView>

            <!-- Camera Button -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cameraButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignEnd="@id/profileCard"
                android:layout_alignBottom="@id/profileCard"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#717C6D">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_camera"
                    android:contentDescription="Add photo"
                    app:tint="@color/white" />
            </androidx.cardview.widget.CardView>
        </RelativeLayout>

        <!-- Name Label -->
        <TextView
            android:id="@+id/nameLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/profilePictureContainer"
            android:layout_alignParentStart="true"
            android:layout_marginStart="20dp"
            android:layout_marginTop="32dp"
            android:text="Name"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Name Input -->
        <EditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_below="@id/nameLabel"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_background"
            android:hint=""
            android:inputType="textPersonName"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <!-- Date of Birth Label -->
        <TextView
            android:id="@+id/dobLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/nameInput"
            android:layout_alignParentStart="true"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:text="Date of Birth"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Date of Birth Input -->
        <EditText
            android:id="@+id/dobInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_below="@id/dobLabel"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_background"
            android:hint=""
            android:inputType="date"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <!-- Phone Number Label -->
        <TextView
            android:id="@+id/phoneLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/dobInput"
            android:layout_alignParentStart="true"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:text="Phone Number"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Phone Number Input -->
        <EditText
            android:id="@+id/phoneInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_below="@id/phoneLabel"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_background"
            android:hint=""
            android:inputType="phone"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <!-- Gender Label -->
        <TextView
            android:id="@+id/genderLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/phoneInput"
            android:layout_alignParentStart="true"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:text="Gender"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Gender Input/Spinner -->
        <Spinner
            android:id="@+id/genderSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_below="@id/genderLabel"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_background"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />

        <!-- Complete Profile Button -->
        <Button
            android:id="@+id/completeProfileButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_below="@id/genderSpinner"
            android:layout_marginTop="24dp"
            android:backgroundTint="#717C6D"
            android:text="Complete Profile"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textAllCaps="false"
            app:cornerRadius="28dp" />

        <FrameLayout
            android:id="@+id/UserLocFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

    </RelativeLayout>

</RelativeLayout>