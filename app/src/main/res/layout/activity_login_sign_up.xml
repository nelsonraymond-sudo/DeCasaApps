<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFDFD"
    android:padding="25dp"
    tools:context=".LoginSignUp">

    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="Globe icon"
                android:src="@drawable/ic_globe" />

            <TextView
                android:id="@+id/languageIndo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Indonesia"
                android:textColor="#4285F4"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="Globe icon"
                android:src="@drawable/ic_globe" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="English"
                android:textColor="#4285F4"
                android:textSize="14sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- House Image with rounded corners -->
    <androidx.cardview.widget.CardView
        android:id="@+id/imageCard"
        android:layout_width="wrap_content"
        android:layout_height="200dp"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/headerLayout"
        android:layout_marginTop="70dp"
        app:cardCornerRadius="25dp"
        android:clipToOutline="true"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/houseImage"
            android:layout_width="328dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="Modern house"
            android:scaleType="fitXY"
            android:src="@drawable/loginsignup1" />
    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/welcomeText"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/imageCard"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:scaleType="fitCenter"
        android:src="@drawable/welcome" />

    <!-- Login Button -->

    <!-- Sign Up Button -->

    <Button
        android:id="@+id/loginButton"
        android:layout_width="304dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/welcomeText"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="50dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="50dp"
        android:backgroundTint="#717C6D"
        android:gravity="center"
        android:text="Login"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:cornerRadius="28dp" />

    <Button
        android:id="@+id/signUpButton"
        android:layout_width="304dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/loginButton"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="50dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="50dp"
        android:backgroundTint="#E8E8E8"
        android:text="Sign Up"
        android:textAllCaps="false"
        android:textColor="#666666"
        android:textSize="16sp"
        app:cornerRadius="28dp" />

    <!-- Divider with "or" -->
    <RelativeLayout
        android:id="@+id/dividerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/signUpButton"
        android:layout_marginTop="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="---- or ----"
            android:textColor="#999999"
            android:textSize="14sp" />
    </RelativeLayout>

    <!-- Google Sign In Button -->
    <Button
        android:id="@+id/googleButton"
        android:layout_width="304dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/dividerLayout"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="50dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="50dp"
        android:backgroundTint="@color/white"
        android:drawableStart="@drawable/ic_google"
        android:drawablePadding="12dp"
        android:text="Continue with Google"
        android:textAllCaps="false"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:cornerRadius="28dp"
        app:strokeColor="#3F50B4"
        app:strokeWidth="1dp" />
</RelativeLayout>